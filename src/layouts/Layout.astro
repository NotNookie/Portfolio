---
import "@fontsource-variable/hanken-grotesk/index.css";
import "@fontsource-variable/jetbrains-mono/index.css";
import "material-symbols/outlined.css";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const site = Astro.site ?? new URL(Astro.url.origin);
const pageUrl = new URL(Astro.url.pathname, site).href;
const ogImage = new URL("/og-image.png", site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#b4cbe8" />
    <link rel="canonical" href={pageUrl} />

    <!-- link previews (Facebook, Messenger, Discord, LinkedIn, X…) -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Lhexus Paul M. Sosong, looking for internships: portfolio preview card" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      // Show the boot screen once per session (skipped for reduced motion).
      (function () {
        var booted = false;
        try {
          booted = sessionStorage.getItem("booted") === "1";
        } catch (e) {}
        if (!booted && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          var html = document.documentElement;
          html.classList.add("booting");
          setTimeout(function () {
            html.classList.remove("booting");
          }, 4000);
        }
      })();
    </script>
  </head>
  <body class="min-h-dvh overflow-x-hidden">
    <Fragment set:html={`<!--
THESIS: The portfolio is a desktop session on "lhexus.os": every section is an app window with working minimize/maximize/close/drag and tabs, the dock is the launcher, and the window you are reading takes focus (cobalt title bar). Refuses the stacked hero + card-grid template.
OWN-WORLD: Sky-blue grainy desktop with a navy pixel-block band behind a tiled pixel-icon dock, white/navy windows with 1.5px ink borders, 10px corners and hard 5px offset shadows; cobalt #2F4BFF focus, signal yellow #FFD23F selection; Hanken Grotesk 800 caps display, JetBrains Mono for filenames, data and dates; Material Symbols icons.
STORY: Visitor meets Lhexus by name and face, reads the objective, opens work samples, checks skills with proof, verifies certificates, then contacts.
FIRST VIEWPORT: Short boot screen, then the desktop: giant caps name painted on the wallpaper, desktop shortcut icons, Welcome app window with photo, status and contacts; dock fixed at bottom.
FORM: Pinned by brief (retro desktop OS), seed: brief-pinned (no roll).
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance
-->`} />
    <slot />
    <script>
      import "../scripts/os";
    </script>
  </body>
</html>
