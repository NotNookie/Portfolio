export type PixelIconName = keyof typeof icons;

interface Props {
  name: PixelIconName;
  class?: string;
}

const { name, class: className = "" } = Astro.props;
const fills: Record<string, string> = { K: "var(--px-line)", Y: "var(--px-fill)", W: "var(--px-paper)" };

// Merge horizontal runs of the same colour into single rects.
const rects: { x: number; y: number; w: number; fill: string }[] = [];
icons[name].forEach((row, y) => {
  let x = 0;
  while (x < row.length) {
    const ch = row[x];
    let end = x;
    while (end < row.length && row[end] === ch) end++;
    if (ch !== ".") rects.push({ x, y, w: end - x, fill: fills[ch] });
    x = end;
  }
});
---

<svg
  class:list={["px-icon", className]}
  viewBox="0 0 16 16"
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {rects.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" fill={r.fill} />)}
</svg>
