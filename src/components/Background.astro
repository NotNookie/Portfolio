---
import Window from "./Window.astro";
import PixelIcon from "./PixelIcon.astro";
import { highlights, milestones, certificates, type MilestoneKind } from "../data/site";

const certByFile = new Map(certificates.map((c) => [c.fileUrl, c]));
const certCount = milestones.filter((m) => m.cert).length;

const kinds: Record<MilestoneKind, { label: string; icon: string }> = {
  competition: { label: "Competition", icon: "emoji_events" },
  training: { label: "Training", icon: "school" },
  seminar: { label: "Seminar", icon: "co_present" },
  education: { label: "Education", icon: "account_balance" },
  leadership: { label: "Leadership", icon: "groups" },
};

const filters: { id: string; label: string; match: MilestoneKind[] }[] = [
  { id: "all", label: "All", match: [] },
  { id: "competition", label: "Competitions", match: ["competition"] },
  { id: "learning", label: "Training & seminars", match: ["training", "seminar"] },
  { id: "education", label: "Education", match: ["education"] },
  { id: "leadership", label: "Leadership", match: ["leadership"] },
];
const countFor = (f: (typeof filters)[number]) =>
  f.match.length ? milestones.filter((m) => f.match.includes(m.kind)).length : milestones.length;

const years = [...new Set(milestones.map((m) => m.date.slice(0, 4)))].sort().reverse();
const byYear = years.map((y) => ({
  year: y,
  items: milestones.filter((m) => m.date.startsWith(y)).sort((a, b) => b.date.localeCompare(a.date)),
}));

const [featured, ...others] = highlights;
---

<section id="background" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
  <Window
    title="Background & Achievements"
    file="achievements.exe"
    icon="medal"
    section="background"
    status={`${milestones.length} milestones · ${certCount} certificates attached`}
  >
    <!-- highlights -->
    <div class="grid gap-4 border-b-[1.5px] border-line bg-win-2 p-4 sm:p-6 lg:grid-cols-12">
      <article
        class="relative flex flex-col overflow-hidden rounded-xl border-2 border-line bg-hi p-5 text-on-hi shadow-[4px_4px_0_0_var(--shadow)] sm:p-6 lg:col-span-7 lg:row-span-3"
      >
        <div class="flex items-start gap-4">
          <span class="grid size-16 shrink-0 place-items-center rounded-xl border-2 border-line bg-win">
            <PixelIcon name={featured.icon} class="!size-11" />
          </span>
          <div>
            <p class="font-mono text-[11px] font-bold tracking-[0.1em] uppercase">Highlight</p>
            <h3 class="mt-1 text-2xl leading-tight font-extrabold tracking-[-0.02em] text-balance sm:text-3xl">
              {featured.title}
            </h3>
          </div>
        </div>
        <p class="mt-4 text-[15px] leading-relaxed">{featured.detail}</p>
        {
          featured.chips && (
            <ul class="mt-auto grid grid-cols-2 gap-2 pt-4">
              {featured.chips.map((c) => {
                const [year, place] = c.split(" · ");
                return (
                  <li class="rounded-lg border-[1.5px] border-line bg-win px-3 py-2">
                    <span class="block font-mono text-[11px] text-ink-2 uppercase">{year}</span>
                    <span class="block font-bold text-ink">{place}</span>
                  </li>
                );
              })}
            </ul>
          )
        }
      </article>

      {
        others.map((h) => (
          <article class="hl flex items-start gap-4 rounded-xl border-2 border-line p-4 shadow-[4px_4px_0_0_var(--shadow)] sm:p-5 lg:col-span-5" data-color={h.color}>
            <span class="grid size-12 shrink-0 place-items-center rounded-lg border-2 border-line bg-win">
              <PixelIcon name={h.icon} class="!size-8" />
            </span>
            <div>
              <h3 class="text-lg leading-snug font-extrabold">{h.title}</h3>
              <p class="hl-detail mt-1 text-[14.5px] leading-relaxed">{h.detail}</p>
            </div>
          </article>
        ))
      }
    </div>

    <!-- filters -->
    <div class="flex flex-wrap items-center gap-2 border-b border-line-soft px-4 py-3 sm:px-6" role="toolbar" aria-label="Filter milestones" data-filters hidden>
      <span class="mr-1 font-mono text-[12px] text-ink-2">Show:</span>
      {
        filters.map((f, i) => (
          <button
            type="button"
            class="filter-btn"
            data-filter={f.match.join(",")}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {f.label}
            <span class="tabular opacity-70">{countFor(f)}</span>
          </button>
        ))
      }
    </div>

    <!-- timeline -->
    <div class="px-4 py-6 sm:px-6 sm:py-8">
      <h3 class="sr-only">Timeline</h3>
      <ol class="space-y-8">
        {
          byYear.map(({ year, items }) => (
            <li class="year grid gap-4 sm:grid-cols-[6.5rem_1fr]" data-year={year}>
              <p class="tabular font-mono text-3xl font-extrabold tracking-tight sm:sticky sm:top-4 sm:self-start">
                {year}
              </p>
              <ol class="timeline space-y-3">
                {items.map((m) => {
                  const cert = m.cert ? certByFile.get(m.cert) : undefined;
                  return (
                    <li class="milestone relative pl-7" data-kind={m.kind}>
                      <span class:list={["node", `node-${m.kind}`]} aria-hidden="true" />
                      <div class="grid gap-4 rounded-lg border-[1.5px] border-line bg-win p-4 sm:grid-cols-[1fr_auto]">
                        <div class="min-w-0">
                          <div class="flex flex-wrap items-center gap-2">
                            <span class:list={["kind-tag", `kind-${m.kind}`]}>
                              <span class="material-symbols-outlined !text-[14px]" aria-hidden="true">
                                {kinds[m.kind].icon}
                              </span>
                              {kinds[m.kind].label}
                            </span>
                            <span class="tabular font-mono text-[12px] text-ink-2">{m.when}</span>
                          </div>
                          <h4 class="mt-2 text-lg leading-snug font-bold text-balance">{m.title}</h4>
                          <p class="text-[14.5px] text-ink-2">{m.org}</p>
                          {m.detail && <p class="mt-1 text-[14.5px]">{m.detail}</p>}
                        </div>
                        {cert && (
                          <a
                            href={cert.fileUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="cert-thumb group"
                          >
                            <img
                              src={cert.thumbUrl}
                              alt=""
                              width="800"
                              height={cert.kind === "pdf" ? 1131 : 600}
                              loading="lazy"
                              decoding="async"
                              class:list={["h-full w-full object-cover", cert.kind === "pdf" ? "object-top" : "object-center"]}
                            />
                            {cert.status === "pending" && <span class="cert-pending">ID shown · cert pending</span>}
                            <span class="cert-open">
                              <span class="material-symbols-outlined !text-[14px]" aria-hidden="true">
                                {cert.kind === "pdf" ? "picture_as_pdf" : "image"}
                              </span>
                              View certificate
                            </span>
                            <span class="sr-only">for {m.title} (opens in a new tab)</span>
                          </a>
                        )}
                      </div>
                    </li>
                  );
                })}
              </ol>
            </li>
          ))
        }
      </ol>
    </div>
  </Window>
</section>

<style>
  .hl {
    background: var(--app);
    color: var(--on-app);
  }
  .hl-detail {
    color: color-mix(in srgb, var(--on-app) 88%, transparent);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hl {
      transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .hl:hover {
      transform: translate(-2px, -2px);
    }
  }

  .timeline {
    position: relative;
  }
  .timeline::before {
    content: "";
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 6px;
    width: 2px;
    background: repeating-linear-gradient(var(--line) 0 6px, transparent 6px 10px);
  }
  .node {
    position: absolute;
    top: 1.15rem;
    left: 0;
    width: 14px;
    height: 14px;
    border: 2px solid var(--line);
    border-radius: 3px;
    background: var(--win);
  }
  .node-competition {
    background: var(--hi);
  }
  .node-training {
    background: var(--accent);
  }
  .node-seminar {
    background: #6b3ff0;
  }
  .node-education {
    background: #12805a;
  }
  .node-leadership {
    background: #ff8fb1;
  }

  .kind-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.1rem 0.5rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .kind-competition {
    background: var(--hi);
    color: var(--on-hi);
  }
  .kind-training {
    background: var(--accent-wash);
    color: var(--accent-ink);
  }
  .kind-seminar {
    background: #ece6ff;
    color: #4a22c4;
  }
  .kind-education {
    background: #dcf3e8;
    color: #0b5c40;
  }
  .kind-leadership {
    background: #ffe1ea;
    color: #8a1c43;
  }

  .cert-thumb {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1.5px solid var(--line);
    border-radius: 8px;
    background: var(--win-3);
  }
  @media (min-width: 640px) {
    .cert-thumb {
      width: 11rem;
    }
  }
  .cert-thumb img {
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cert-thumb:hover img {
    transform: scale(1.05);
  }
  .cert-open {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.5rem;
    border-top: 1.5px solid var(--line);
    background: var(--win);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--accent-ink);
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .cert-thumb:hover .cert-open {
    background: var(--accent);
    color: var(--on-accent);
  }
  .cert-pending {
    position: absolute;
    top: 0.4rem;
    left: 0.4rem;
    padding: 0.05rem 0.4rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--hi);
    color: var(--on-hi);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-weight: 700;
  }

  .filter-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--win);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .filter-btn:hover {
    background: var(--accent-wash);
  }
  .filter-btn[aria-pressed="true"] {
    background: var(--ink);
    color: var(--win);
  }
  [data-filters][hidden],
  .milestone[hidden],
  .year[hidden] {
    display: none;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>("[data-filters]");
  if (bar) {
    bar.hidden = false;
    const buttons = Array.from(bar.querySelectorAll<HTMLButtonElement>("[data-filter]"));
    const milestones = Array.from(document.querySelectorAll<HTMLElement>("#background .milestone"));
    const years = Array.from(document.querySelectorAll<HTMLElement>("#background .year"));
    bar.addEventListener("click", (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-filter]");
      if (!b) return;
      const match = b.dataset.filter ? b.dataset.filter.split(",") : [];
      buttons.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
      milestones.forEach((m) => (m.hidden = match.length > 0 && !match.includes(m.dataset.kind!)));
      years.forEach((y) => (y.hidden = !y.querySelector(".milestone:not([hidden])")));
    });
  }
</script>
