---
import Window from "./Window.astro";
import {
  education,
  codeFest,
  itso,
  certifications,
  seminars,
  activities,
  type TimelineItem,
} from "../data/site";

const folders: { name: string; icon: string; items: TimelineItem[]; open?: boolean; codefest?: boolean }[] = [
  { name: "Education", icon: "school", items: education, open: true },
  { name: "Competitions", icon: "emoji_events", items: [itso], codefest: true },
  { name: "Seminars & Training", icon: "co_present", items: [...seminars, ...certifications] },
  { name: "Leadership & Activities", icon: "groups", items: activities },
];

const count = (f: (typeof folders)[number]) => f.items.length + (f.codefest ? 1 : 0);
---

<section id="background" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
  <Window title="background.exe" icon="history_edu" meta={`${folders.length} folders`} section="background">
    <div class="p-4 sm:p-8">
      <h2 class="text-3xl font-extrabold tracking-[-0.02em] sm:text-4xl">Background</h2>

      <div class="mt-6 overflow-hidden rounded-lg border-[1.5px] border-line sm:mt-8">
        {
          folders.map((folder, fi) => (
            <details class:list={["row group bg-win", fi > 0 && "border-t-[1.5px] border-line"]} open={folder.open}>
              <summary class="flex items-center gap-3 px-4 py-4 transition-colors hover:bg-win-2 sm:px-5">
                <span class="material-symbols-outlined row-chevron !text-[20px] text-ink-2" aria-hidden="true">
                  chevron_right
                </span>
                <span class="material-symbols-outlined fill-icon row-folder-closed text-accent" aria-hidden="true">folder</span>
                <span class="material-symbols-outlined fill-icon row-folder-open text-accent" aria-hidden="true">folder_open</span>
                <span class="flex-1 text-lg font-bold">{folder.name}</span>
                <span class="tabular font-mono text-[12px] text-ink-2">
                  {count(folder)} {count(folder) === 1 ? "item" : "items"}
                </span>
              </summary>

              <div class="border-t border-line-soft bg-win-2 px-4 py-2 sm:px-5 sm:pl-[4.25rem]">
                {folder.codefest && (
                  <div class="border-b border-line-soft py-4">
                    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                      <h3 class="font-bold">
                        {codeFest.title}: {codeFest.org}
                      </h3>
                      <p class="tabular font-mono text-[12px] text-ink-2">1st – 4th Year</p>
                    </div>
                    <p class="mt-1 max-w-[70ch] text-[15px] text-ink-2">{codeFest.detail}</p>
                    <ul class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
                      {codeFest.results.map((r) => (
                        <li>
                          <a
                            href={r.certUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="lift block rounded-md border-[1.5px] border-line bg-win p-3"
                          >
                            <span class="block font-mono text-[11px] text-ink-2 uppercase">{r.year}</span>
                            <span class="block font-bold">{r.place}</span>
                            <span class="mt-1 inline-flex items-center gap-1 font-mono text-[11px] text-accent-ink">
                              View certificate
                              <span class="material-symbols-outlined !text-[13px]" aria-hidden="true">north_east</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )}
                <ul class="divide-y divide-line-soft">
                  {folder.items.map((item) => (
                    <li class="py-4">
                      <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                        <h3 class="font-bold">{item.title}</h3>
                        <p class="tabular font-mono text-[12px] text-ink-2">{item.period}</p>
                      </div>
                      <p class="text-[15px] text-ink-2">{item.org}</p>
                      {item.detail && <p class="mt-1 max-w-[70ch] text-[15px]">{item.detail}</p>}
                      {item.certUrl && (
                        <a
                          href={item.certUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="mt-2 inline-flex items-center gap-1 font-mono text-[12px] text-accent-ink underline decoration-dotted hover:decoration-solid"
                        >
                          View certificate
                          <span class="material-symbols-outlined !text-[14px]" aria-hidden="true">north_east</span>
                          <span class="sr-only">(opens in a new tab)</span>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </Window>
</section>
