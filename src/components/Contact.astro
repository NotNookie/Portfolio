---
import Window from "./Window.astro";
import { contactGroups, profile } from "../data/site";

const external = (href: string) => href.startsWith("http") || href.endsWith(".pdf");
---

<section id="contact" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
  <Window title="say_hello.txt" icon="alternate_email" meta="contact" section="contact">
    <div class="grid gap-10 p-5 sm:p-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <h2 class="text-[clamp(2.25rem,6vw,4.25rem)] leading-[0.95] font-extrabold tracking-[-0.03em] text-balance uppercase">
          Let's build something <span class="text-accent">that ships.</span>
        </h2>
        <p class="mt-5 max-w-[52ch] text-lg text-ink-2">
          Have a project in mind, or just want to say hi? Send a message - I read every one.
        </p>

        <div class="mt-8 grid gap-6 sm:grid-cols-3">
          {
            contactGroups.map((group) => (
              <div>
                <p class="label">// {group.label}</p>
                <ul class="mt-3 space-y-2">
                  {group.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        target={external(link.href) ? "_blank" : undefined}
                        rel={external(link.href) ? "noopener noreferrer" : undefined}
                        class="inline-flex items-start gap-2 text-[15px] font-medium break-all hover:text-accent-ink hover:underline"
                      >
                        <span class="material-symbols-outlined !text-[18px] text-ink-2" aria-hidden="true">
                          {link.icon}
                        </span>
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>

      <div class="lg:col-span-5">
        <form
          class="space-y-4 rounded-lg border-[1.5px] border-line bg-win-2 p-5"
          method="POST"
          action={`mailto:${profile.email}`}
          enctype="text/plain"
        >
          <p class="flex items-center gap-2 font-mono text-[13px] font-medium">
            <span class="material-symbols-outlined !text-[17px]" aria-hidden="true">edit_note</span>
            New message
          </p>
          <div class="space-y-1.5">
            <label for="contact-name" class="label">Name</label>
            <input
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              required
              placeholder="Your name"
              class="w-full rounded-md border-[1.5px] border-line bg-win px-3 py-2.5 placeholder:text-ink-2/80 focus:border-accent focus:outline-none"
            />
          </div>
          <div class="space-y-1.5">
            <label for="contact-email" class="label">Email</label>
            <input
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="email@example.com"
              class="w-full rounded-md border-[1.5px] border-line bg-win px-3 py-2.5 placeholder:text-ink-2/80 focus:border-accent focus:outline-none"
            />
          </div>
          <div class="space-y-1.5">
            <label for="contact-message" class="label">Message</label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              placeholder="How can I help you?"
              class="w-full resize-y rounded-md border-[1.5px] border-line bg-win px-3 py-2.5 placeholder:text-ink-2/80 focus:border-accent focus:outline-none"
            ></textarea>
          </div>
          <button type="submit" class="btn btn-primary w-full">
            Send message
            <span class="material-symbols-outlined !text-[18px]" aria-hidden="true">send</span>
          </button>
        </form>
      </div>
    </div>
  </Window>
</section>
