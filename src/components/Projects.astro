---
import Window from "./Window.astro";
import { projects, type Project } from "../data/site";

// First project is featured full-width; if that leaves an odd one out,
// the last project goes full-width too (image on the right).
const isWide = (i: number) => i === 0 || (i === projects.length - 1 && (projects.length - 1) % 2 === 1);
---

<section id="projects" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
  <Window
    title="Work Samples"
    file="projects.exe"
    icon="folder"
    section="projects"
    path="~/lhexus/projects"
    status={`${projects.length} items · ${projects.filter((p) => p.liveUrl).length} live`}
  >
    <div class="p-4 sm:p-8">
      <p class="mb-6 max-w-[60ch] text-ink-2 sm:mb-8">
          Things I've built, shipped, or am building right now, from client work to a game jam entry.
      </p>

      <div class="grid gap-5 sm:gap-6 md:grid-cols-2">
        {
          projects.map((project: Project, i: number) => (
            <article
              class:list={[
                "lift flex flex-col overflow-hidden rounded-lg border-[1.5px] border-line bg-win shadow-[3px_3px_0_0_var(--shadow)]",
                isWide(i) && "md:col-span-2 md:grid md:grid-cols-[1.15fr_1fr]",
                isWide(i) && i > 0 && "md:grid-cols-[1fr_1.15fr]",
              ]}
            >
              <div
                class:list={[
                  "relative overflow-hidden border-b-[1.5px] border-line bg-win-3",
                  isWide(i) ? "aspect-[16/10] md:aspect-auto md:h-full md:min-h-80 md:border-b-0" : "aspect-[16/10]",
                  isWide(i) && (i === 0 ? "md:border-r-[1.5px]" : "md:order-2 md:border-l-[1.5px]"),
                ]}
              >
                {project.imageUrl ? (
                  <img
                    src={project.imageUrl}
                    alt={project.imageAlt}
                    width={960}
                    height={600}
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-cover object-top"
                  />
                ) : (
                  <div class="absolute inset-0 grid place-items-center" role="img" aria-label={project.imageAlt}>
                    <span class="material-symbols-outlined !text-5xl text-ink-2" aria-hidden="true">
                      {project.tags[0]?.icon ?? "code"}
                    </span>
                  </div>
                )}
              </div>

              <div class="flex flex-1 flex-col gap-4 p-5 sm:p-6">
                <div>
                  {project.role && (
                    <p class="font-mono text-[12px] leading-snug font-medium text-accent-ink">{project.role}</p>
                  )}
                  <h3
                    class:list={[
                      "mt-1.5 font-extrabold tracking-[-0.015em] text-balance",
                      isWide(i) ? "text-2xl sm:text-3xl" : "text-xl sm:text-2xl",
                    ]}
                  >
                    {project.title}
                  </h3>
                </div>
                <p class="text-ink-2">{project.description}</p>
                <div class="rounded-md bg-win-2 p-3.5">
                  <p class="label !text-[11px]">Impact</p>
                  <p class="mt-1 text-[15px] leading-relaxed">{project.impact}</p>
                </div>
                <ul class="flex flex-wrap gap-1.5" aria-label="Tech stack">
                  {project.tags.map((tag) => (
                    <li class="chip">
                      {tag.iconSrc ? (
                        <img src={tag.iconSrc} alt="" width={14} height={14} class="size-3.5 rounded-[3px] object-contain" />
                      ) : (
                        <span class="material-symbols-outlined !text-[14px]" aria-hidden="true">
                          {tag.icon}
                        </span>
                      )}
                      {tag.label}
                    </li>
                  ))}
                </ul>
                <div class="mt-auto flex flex-wrap gap-2.5 pt-1">
                  {project.liveUrl && (
                    <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary !px-3.5 !py-2 !text-sm">
                      <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">open_in_new</span>
                      Live
                      <span class="sr-only">: {project.title} (opens in a new tab)</span>
                    </a>
                  )}
                  {project.codeUrl && (
                    <a href={project.codeUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost !px-3.5 !py-2 !text-sm">
                      <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">code</span>
                      Code
                      <span class="sr-only">: {project.title} (opens in a new tab)</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </Window>
</section>
