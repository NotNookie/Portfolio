---
import Window from "./Window.astro";
import { projects } from "../data/site";

const total = projects.length;
---

<section id="projects" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
  <Window
    title="Work Samples"
    file="projects.exe"
    icon="folder"
    section="projects"
    path="~/lhexus/projects"
    status={`${total} projects · ${projects.filter((p) => p.liveUrl).length} live · use ← → to browse`}
  >
    <div class="carousel p-4 sm:p-6" data-carousel aria-roledescription="carousel" aria-label="Projects">
      <!-- stage -->
      <div class="relative" data-carousel-stage>
        {
          projects.map((project, i) => (
            <article
              class="slide grid overflow-hidden rounded-lg border-[1.5px] border-line bg-win shadow-[4px_4px_0_0_var(--shadow)] md:grid-cols-[1.3fr_1fr]"
              data-slide={i}
              role="group"
              aria-roledescription="slide"
              aria-label={`${i + 1} of ${total}: ${project.title}`}
            >
              <div class="relative aspect-[16/10] overflow-hidden border-b-[1.5px] border-line bg-win-3 md:aspect-auto md:min-h-[24rem] md:border-r-[1.5px] md:border-b-0">
                {project.imageUrl ? (
                  <img
                    src={project.imageUrl}
                    alt={project.imageAlt}
                    width={1280}
                    height={800}
                    loading={i === 0 ? "eager" : "lazy"}
                    decoding="async"
                    class="slide-img absolute inset-0 h-full w-full object-cover object-top"
                  />
                ) : (
                  <div class="absolute inset-0 grid place-items-center" role="img" aria-label={project.imageAlt}>
                    <span class="material-symbols-outlined !text-6xl text-ink-2" aria-hidden="true">
                      {project.tags[0]?.icon ?? "code"}
                    </span>
                  </div>
                )}
                <span class="tabular absolute top-3 left-3 rounded-md border-[1.5px] border-line bg-win px-2 py-0.5 font-mono text-[12px] font-medium">
                  {String(i + 1).padStart(2, "0")} / {String(total).padStart(2, "0")}
                </span>
              </div>

              <div class="flex flex-col gap-4 p-5 sm:p-7">
                <div>
                  {project.role && (
                    <p class="font-mono text-[12px] leading-snug font-medium text-accent-ink">{project.role}</p>
                  )}
                  <h3 class="mt-1.5 text-2xl font-extrabold tracking-[-0.02em] text-balance sm:text-3xl">
                    {project.title}
                  </h3>
                </div>
                <p class="text-ink-2">{project.description}</p>
                <div class="rounded-md bg-win-2 p-3.5">
                  <p class="label !text-[11px]">Impact</p>
                  <p class="mt-1 text-[15px] leading-relaxed">{project.impact}</p>
                </div>
                <ul class="flex flex-wrap gap-1.5" aria-label="Tech stack">
                  {project.tags.map((tag) => (
                    <li class="chip">
                      {tag.iconSrc ? (
                        <img src={tag.iconSrc} alt="" width={14} height={14} class="size-3.5 rounded-[3px] object-contain" />
                      ) : (
                        <span class="material-symbols-outlined !text-[14px]" aria-hidden="true">
                          {tag.icon}
                        </span>
                      )}
                      {tag.label}
                    </li>
                  ))}
                </ul>
                <div class="mt-auto flex flex-wrap gap-2.5 pt-1">
                  {project.liveUrl && (
                    <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary !px-3.5 !py-2 !text-sm">
                      <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">open_in_new</span>
                      Live
                      <span class="sr-only">: {project.title} (opens in a new tab)</span>
                    </a>
                  )}
                  {project.codeUrl && (
                    <a href={project.codeUrl} target="_blank" rel="noopener noreferrer" class="btn btn-ghost !px-3.5 !py-2 !text-sm">
                      <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">code</span>
                      Code
                      <span class="sr-only">: {project.title} (opens in a new tab)</span>
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))
        }

        <button type="button" class="carousel-nav left-0 -translate-x-1/2" data-carousel-prev aria-label="Previous project" hidden>
          <span class="material-symbols-outlined" aria-hidden="true">chevron_left</span>
        </button>
        <button type="button" class="carousel-nav right-0 translate-x-1/2" data-carousel-next aria-label="Next project" hidden>
          <span class="material-symbols-outlined" aria-hidden="true">chevron_right</span>
        </button>
      </div>

      <!-- thumbnail strip -->
      <div class="mt-5 flex items-center gap-3" data-carousel-thumbs hidden>
        <ul class="flex flex-1 gap-2.5 overflow-x-auto p-1 [scrollbar-width:thin]" aria-label="Jump to project">
          {
            projects.map((project, i) => (
              <li class="shrink-0">
                <button type="button" class="thumb" data-goto={i} aria-label={`Show ${project.title}`}>
                  {project.imageUrl ? (
                    <img src={project.imageUrl} alt="" width={160} height={100} loading="lazy" decoding="async" class="h-full w-full object-cover object-top" />
                  ) : (
                    <span class="grid h-full place-items-center bg-win-3 font-mono text-[11px]">{project.title}</span>
                  )}
                  <span class="thumb-label">{project.title.split(":")[0]}</span>
                </button>
              </li>
            ))
          }
        </ul>
        <p class="tabular hidden shrink-0 font-mono text-[13px] text-ink-2 sm:block" aria-live="polite" data-carousel-count>
          1 / {total}
        </p>
      </div>
    </div>
  </Window>
</section>

<style>
  .carousel-nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-top: -1.375rem;
    border: 2px solid var(--line);
    border-radius: 12px;
    background: var(--win);
    color: var(--ink);
    box-shadow: 3px 3px 0 0 var(--shadow);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .carousel-nav:hover {
    background: var(--accent);
    color: var(--on-accent);
  }
  .carousel-nav[hidden] {
    display: none;
  }
  @media (max-width: 767px) {
    .carousel-nav {
      top: 6.5rem;
      translate: 0 0 !important;
    }
    .carousel-nav.left-0 {
      left: 0.5rem;
      --tw-translate-x: 0;
    }
    .carousel-nav.right-0 {
      right: 0.5rem;
      --tw-translate-x: 0;
    }
  }

  /* With JS, only the current slide shows. */
  :global(.js-ready) [data-carousel] .slide:not(.is-current) {
    display: none;
  }
  :global(.js-ready) [data-carousel] .slide {
    touch-action: pan-y;
  }
  /* Without JS, slides stack as a list. */
  .slide + .slide {
    margin-top: 1.25rem;
  }
  :global(.js-ready) [data-carousel] .slide + .slide {
    margin-top: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .slide.is-current.is-entering {
      animation: slide-in 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .slide.is-current.is-entering.from-left {
      animation-name: slide-in-left;
    }
  }
  @keyframes slide-in {
    from {
      opacity: 0;
      transform: translateX(24px);
    }
  }
  @keyframes slide-in-left {
    from {
      opacity: 0;
      transform: translateX(-24px);
    }
  }

  .thumb {
    position: relative;
    display: block;
    width: 8.5rem;
    height: 5.25rem;
    overflow: hidden;
    border: 2px solid var(--line-soft);
    border-radius: 8px;
    background: var(--win-3);
    cursor: pointer;
    transition: border-color 0.15s ease, transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .thumb:hover {
    border-color: var(--line);
    transform: translateY(-2px);
  }
  .thumb[aria-current="true"] {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px var(--accent);
  }
  .thumb-label {
    position: absolute;
    inset: auto 0 0 0;
    padding: 0.15rem 0.4rem;
    background: color-mix(in srgb, var(--win) 92%, transparent);
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--ink);
    text-align: left;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .thumb[aria-current="true"] .thumb-label {
    background: var(--accent);
    color: var(--on-accent);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-carousel]").forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-goto]"));
    const prev = root.querySelector<HTMLButtonElement>("[data-carousel-prev]");
    const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]");
    const strip = root.querySelector<HTMLElement>("[data-carousel-thumbs]");
    const count = root.querySelector<HTMLElement>("[data-carousel-count]");
    const stage = root.querySelector<HTMLElement>("[data-carousel-stage]");
    if (!slides.length) return;

    [prev, next, strip].forEach((el) => el && (el.hidden = false));
    let current = 0;

    const show = (i: number, dir = 1) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, idx) => {
        const on = idx === current;
        s.classList.toggle("is-current", on);
        s.classList.remove("is-entering", "from-left");
        s.toggleAttribute("inert", !on);
        if (on) {
          void s.offsetWidth; // restart the entrance animation
          s.classList.add("is-entering");
          if (dir < 0) s.classList.add("from-left");
        }
      });
      thumbs.forEach((t, idx) => {
        if (idx === current) {
          t.setAttribute("aria-current", "true");
          const list = t.closest("ul");
          if (list) list.scrollTo({ left: t.offsetLeft - list.clientWidth / 2 + t.offsetWidth / 2, behavior: "smooth" });
        } else t.removeAttribute("aria-current");
      });
      if (count) count.textContent = `${current + 1} / ${slides.length}`;
    };

    prev?.addEventListener("click", () => show(current - 1, -1));
    next?.addEventListener("click", () => show(current + 1, 1));
    thumbs.forEach((t) => t.addEventListener("click", () => show(Number(t.dataset.goto), Number(t.dataset.goto) < current ? -1 : 1)));

    root.addEventListener("keydown", (e) => {
      if ((e.target as HTMLElement).closest("input, textarea")) return;
      if (e.key === "ArrowRight") {
        e.preventDefault();
        show(current + 1, 1);
      } else if (e.key === "ArrowLeft") {
        e.preventDefault();
        show(current - 1, -1);
      }
    });

    // swipe on touch screens
    let startX = 0;
    let startY = 0;
    stage?.addEventListener("pointerdown", (e) => {
      if (e.pointerType === "mouse") return;
      startX = e.clientX;
      startY = e.clientY;
    });
    stage?.addEventListener("pointerup", (e) => {
      if (e.pointerType === "mouse") return;
      const dx = e.clientX - startX;
      if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(e.clientY - startY)) show(current + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
    });

    show(0);
    slides[0].classList.remove("is-entering");
  });
</script>
