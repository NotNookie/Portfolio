---
import Window from "./Window.astro";
import { certificates } from "../data/site";
---

<section id="certificates" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
  <Window title="certificates.exe" icon="workspace_premium" meta={`${certificates.length} files`} section="certificates">
    <div class="p-4 sm:p-8">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3 sm:mb-8">
        <h2 class="text-3xl font-extrabold tracking-[-0.02em] sm:text-4xl">Certificates &amp; Evidence</h2>
        <p class="max-w-[46ch] text-ink-2">Click any file to open the full certificate in a new tab.</p>
      </div>

      <ul class="grid grid-cols-1 gap-4 min-[480px]:grid-cols-2 sm:gap-5 lg:grid-cols-3">
        {
          certificates.map((c) => (
            <li>
              <a
                href={c.fileUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="lift group flex h-full flex-col overflow-hidden rounded-lg border-[1.5px] border-line bg-win shadow-[3px_3px_0_0_var(--shadow)]"
              >
                <div class="relative aspect-[4/3] overflow-hidden border-b-[1.5px] border-line bg-win-3">
                  <img
                    src={c.thumbUrl}
                    alt=""
                    width="800"
                    height={c.kind === "pdf" ? 1131 : 600}
                    loading="lazy"
                    decoding="async"
                    class:list={[
                      "absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]",
                      c.kind === "pdf" ? "object-top" : "object-center",
                    ]}
                  />
                  <span class="absolute top-2 right-2 chip !border-line !bg-win !py-0.5 !text-[11px] font-medium">
                    <span class="material-symbols-outlined !text-[14px]" aria-hidden="true">
                      {c.kind === "pdf" ? "picture_as_pdf" : "image"}
                    </span>
                    {c.kind === "pdf" ? "PDF" : "JPG"}
                  </span>
                  {c.status === "pending" && (
                    <span class="absolute top-2 left-2 chip !border-line !bg-hi !py-0.5 !text-[11px] font-bold !text-on-hi">
                      <span class="material-symbols-outlined !text-[14px]" aria-hidden="true">hourglass_top</span>
                      Pending
                    </span>
                  )}
                </div>
                <div class="flex flex-1 flex-col gap-1 p-4">
                  <h3 class="leading-snug font-bold text-balance">{c.title}</h3>
                  <p class="text-[14px] text-ink-2">{c.issuer}</p>
                  {c.note && <p class="text-[13px] font-medium text-ink">{c.note}</p>}
                  <p class="mt-auto flex items-center justify-between gap-2 pt-2 font-mono text-[12px]">
                    <span class="tabular text-ink-2">{c.date}</span>
                    <span class="inline-flex items-center gap-1 text-accent-ink">
                      View
                      <span class="material-symbols-outlined !text-[14px]" aria-hidden="true">north_east</span>
                    </span>
                  </p>
                  <span class="sr-only">(opens in a new tab)</span>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Window>
</section>
