---
import Window from "./Window.astro";
import { profile, socialLinks } from "../data/site";
---

<section id="hero" class="relative mx-auto max-w-6xl px-4 pt-20 pb-12 sm:px-6 sm:pt-24 lg:pb-10">
  <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7">
      <p
        class="inline-flex flex-wrap items-center gap-x-2 gap-y-1 rounded-md border-[1.5px] border-line bg-win px-3 py-1.5 font-mono text-[12px] text-ink sm:text-[13px]"
      >
        <span class="material-symbols-outlined !text-[16px] text-accent-ink" aria-hidden="true">school</span>
        <span>{profile.course}</span>
        <span class="text-ink-2" aria-hidden="true">·</span>
        <span>{profile.school}</span>
        <span class="text-ink-2" aria-hidden="true">·</span>
        <span>{profile.year}</span>
      </p>

      <h1
        class="mt-6 text-[clamp(2.6rem,7.6vw,5.5rem)] leading-[0.92] font-extrabold tracking-[-0.035em] text-balance uppercase"
      >
        <span class="block">{profile.firstName}</span>
        <span class="block"><span class="text-accent">M.</span> {profile.lastName}</span>
      </h1>

      <p class="mt-5 font-mono text-lg font-medium sm:text-xl">
        <span class="text-accent-ink" aria-hidden="true">&gt;&nbsp;</span>{profile.role}<span class="caret" aria-hidden="true"></span>
      </p>

      <p class="mt-4 max-w-[60ch] text-ink-2 sm:text-[17px]">{profile.tagline}</p>

      <ul class="mt-6 flex flex-wrap gap-2" aria-label="Contact details">
        {
          socialLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.href.startsWith("http") ? "_blank" : undefined}
                rel={link.href.startsWith("http") ? "noopener noreferrer" : undefined}
                class="chip lift !border-line !bg-win hover:!bg-accent-wash"
              >
                <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">{link.icon}</span>
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="chip !border-transparent !bg-transparent !px-1 text-ink-2">
          <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">location_on</span>
          {profile.location}
        </li>
      </ul>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#projects" class="btn btn-primary">
          <span class="material-symbols-outlined !text-[18px]" aria-hidden="true">folder_open</span>
          Open my work
        </a>
        <a href={profile.resume} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">
          <span class="material-symbols-outlined !text-[18px]" aria-hidden="true">picture_as_pdf</span>
          Resume / CV
        </a>
      </div>
    </div>

    <div class="relative mx-auto w-full max-w-[22rem] sm:max-w-sm lg:col-span-5 lg:max-w-none lg:pl-6">
      <Window title="lhexus_sosong.jpg" icon="image" meta="900×1200" section="hero" reveal={false}>
        <img
          src={profile.photo}
          alt={`Portrait of ${profile.name} in a dark suit and tie, smiling`}
          width="900"
          height="1200"
          fetchpriority="high"
          decoding="async"
          class="block aspect-[4/4.6] w-full bg-[#f2f2f0] object-cover object-[50%_12%]"
        />
      </Window>

      <aside
        class="absolute -bottom-6 -left-3 w-48 -rotate-3 rounded-sm border-[1.5px] border-line bg-hi p-3 text-on-hi shadow-[3px_3px_0_0_var(--shadow)] sm:-left-8 sm:w-52"
        aria-label="Currently"
      >
        <p class="font-mono text-[11px] font-bold tracking-[0.08em] uppercase">Currently</p>
        <p class="mt-1 text-[14px] leading-snug font-semibold">
          Building Iskolar, a multi-tenant scholarship platform, as my capstone.
        </p>
      </aside>
    </div>
  </div>

  <a
    href="#about"
    class="mt-14 hidden items-center gap-2 font-mono text-[12px] text-ink-2 hover:text-ink lg:inline-flex"
  >
    <span class="material-symbols-outlined !text-[18px]" aria-hidden="true"
      >arrow_downward</span
    >
    Scroll down
  </a>
</section>
