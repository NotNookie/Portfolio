---
import Window from "./Window.astro";
import PixelIcon, { type PixelIconName } from "./PixelIcon.astro";
import { profile } from "../data/site";

const shortcuts: { label: string; href: string; icon: PixelIconName; external?: boolean }[] = [
  { label: "Resume.pdf", href: profile.resume, icon: "doc", external: true },
  { label: "Email", href: `mailto:${profile.email}`, icon: "mail" },
  { label: "GitHub", href: profile.github, icon: "term", external: true },
  { label: "LinkedIn", href: profile.linkedin, icon: "card", external: true },
  { label: "Itch.io", href: profile.itch, icon: "gamepad", external: true },
];
---

<section id="hero" class="relative mx-auto max-w-6xl px-4 pt-16 pb-12 sm:px-6 sm:pt-20 lg:pb-10">
  <div class="grid items-start gap-10 lg:grid-cols-12 lg:gap-8">
    <!-- wallpaper: name + desktop shortcuts -->
    <div class="lg:col-span-7 lg:pt-6">
      <h1 class="wallpaper-name text-[clamp(2.75rem,8vw,6rem)] leading-[0.9] font-extrabold tracking-[-0.035em] uppercase">
        <span class="block">{profile.firstName}</span>
        <span class="block"><span class="text-accent">M.</span> {profile.lastName}</span>
      </h1>

      <p class="mt-5 font-mono text-lg font-medium sm:text-xl">
        <span class="text-accent-ink" aria-hidden="true">&gt;&nbsp;</span>{profile.status}<span
          class="caret"
          aria-hidden="true"></span>
      </p>

      <nav aria-label="Desktop shortcuts" class="mt-8 sm:mt-10">
        <ul class="flex flex-wrap gap-x-1 gap-y-4 sm:gap-x-4">
          {
            shortcuts.map((s) => (
              <li>
                <a
                  href={s.href}
                  target={s.external ? "_blank" : undefined}
                  rel={s.external ? "noopener noreferrer" : undefined}
                  class="shortcut group flex w-16 flex-col items-center gap-1.5 text-center sm:w-20"
                >
                  <span class="grid size-14 place-items-center rounded-xl border-2 border-line bg-win shadow-[3px_3px_0_0_var(--shadow)] transition-transform duration-200 group-hover:-translate-y-0.5">
                    <PixelIcon name={s.icon} class="!size-8" />
                  </span>
                  <span class="shortcut-label rounded px-1.5 py-0.5 font-mono text-[11px] leading-tight font-medium">
                    {s.label}
                  </span>
                  {s.external && <span class="sr-only">(opens in a new tab)</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- Welcome app -->
    <div class="relative lg:col-span-5">
      <Window title="Welcome" file="welcome.app" icon="person" section="hero" reveal={false} closable={false} as="p">
        <div class="grid grid-cols-[7.5rem_1fr] sm:grid-cols-[9rem_1fr]">
          <img
            src={profile.photo}
            alt={`Portrait of ${profile.name} in a dark suit and tie, smiling`}
            width="900"
            height="1200"
            fetchpriority="high"
            decoding="async"
            class="h-full w-full border-r-[1.5px] border-line bg-[#f2f2f0] object-cover object-[50%_10%]"
          />
          <div class="space-y-3 p-4 sm:p-5">
            <p class="text-lg leading-snug font-extrabold sm:text-xl">Hi, I'm {profile.firstName.split(" ")[0]}.</p>
            <p class="font-mono text-[12px] leading-relaxed text-ink-2">
              {profile.course}<br />{profile.school} · {profile.year}
            </p>
            <dl class="space-y-1.5 text-[13.5px]">
              <div class="flex items-start gap-2">
                <dt class="sr-only">Email</dt>
                <span class="material-symbols-outlined !text-[16px] text-ink-2" aria-hidden="true">mail</span>
                <dd><a href={`mailto:${profile.email}`} class="break-all hover:text-accent-ink hover:underline">{profile.email}</a></dd>
              </div>
              <div class="flex items-start gap-2">
                <dt class="sr-only">Phone</dt>
                <span class="material-symbols-outlined !text-[16px] text-ink-2" aria-hidden="true">call</span>
                <dd><a href={`tel:${profile.phone.replace(/\s+/g, "")}`} class="hover:text-accent-ink hover:underline">{profile.phone}</a></dd>
              </div>
              <div class="flex items-start gap-2">
                <dt class="sr-only">Location</dt>
                <span class="material-symbols-outlined !text-[16px] text-ink-2" aria-hidden="true">location_on</span>
                <dd>{profile.location}</dd>
              </div>
            </dl>
          </div>
        </div>
        <div class="space-y-4 border-t-[1.5px] border-line p-4 sm:p-5">
          <p class="text-[15px] leading-relaxed text-ink-2">{profile.tagline}</p>
          <div class="flex flex-wrap gap-2.5">
            <a href="#projects" class="btn btn-primary !px-3.5 !py-2 !text-sm">
              <span class="material-symbols-outlined !text-[17px]" aria-hidden="true">folder_open</span>
              Open my work
            </a>
            <a href="#about" class="btn btn-ghost !px-3.5 !py-2 !text-sm">
              <span class="material-symbols-outlined !text-[17px]" aria-hidden="true">article</span>
              Read objective
            </a>
          </div>
        </div>
      </Window>

      <aside
        class="relative mt-6 ml-3 w-52 -rotate-2 rounded-sm border-[1.5px] border-line bg-hi p-3 text-on-hi shadow-[3px_3px_0_0_var(--shadow)] lg:-mt-3 lg:-ml-8"
        aria-label="Currently"
      >
        <p class="font-mono text-[11px] font-bold tracking-[0.08em] uppercase">Currently</p>
        <p class="mt-1 text-[14px] leading-snug font-semibold">
          Building Iskolar, a multi-tenant scholarship platform, as my capstone.
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .wallpaper-name {
    color: var(--ink);
    text-shadow: 4px 4px 0 var(--win);
  }
  .shortcut-label {
    color: var(--ink);
    background: color-mix(in srgb, var(--win) 80%, transparent);
  }
  .shortcut:hover .shortcut-label,
  .shortcut:focus-visible .shortcut-label {
    background: var(--accent);
    color: var(--on-accent);
  }
</style>
