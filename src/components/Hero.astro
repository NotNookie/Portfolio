---
import Window from "./Window.astro";
import PixelIcon, { type PixelIconName } from "./PixelIcon.astro";
import { profile } from "../data/site";

const specs = [
  { k: "Course", v: profile.course },
  { k: "School", v: profile.school },
  { k: "Year", v: `${profile.year} (capstone)` },
  { k: "Graduating", v: "June–July 2027" },
  { k: "Based in", v: profile.location },
  { k: "Focus", v: "React · Node.js · Laravel" },
];

const shortcuts: { label: string; href: string; icon: PixelIconName; external?: boolean }[] = [
  { label: "Resume.pdf", href: profile.resume, icon: "doc", external: true },
  { label: "Email", href: `mailto:${profile.email}`, icon: "mail" },
  { label: "GitHub", href: profile.github, icon: "term", external: true },
  { label: "LinkedIn", href: profile.linkedin, icon: "card", external: true },
  { label: "Itch.io", href: profile.itch, icon: "gamepad", external: true },
];
---

<section id="hero" class="relative mx-auto max-w-6xl px-4 pt-16 pb-12 sm:px-6 sm:pt-20 lg:pb-10">
  <div class="grid items-start gap-10 xl:grid-cols-12 xl:gap-8">
    <!-- wallpaper: name + desktop shortcuts -->
    <div class="xl:col-span-6 xl:pt-6">
      <h1 class="wallpaper-name text-[clamp(2.75rem,7.5vw,5.25rem)] leading-[0.9] font-extrabold tracking-[-0.035em] uppercase">
        <span class="block">{profile.firstName}</span>
        <span class="block"><span class="text-accent">M.</span> {profile.lastName}</span>
      </h1>

      <p class="mt-5 font-mono text-lg font-medium sm:text-xl">
        <span class="text-accent-ink" aria-hidden="true">&gt;&nbsp;</span>{profile.status}<span
          class="caret"
          aria-hidden="true"></span>
      </p>

      <nav aria-label="Desktop shortcuts" class="mt-8 sm:mt-10">
        <ul class="flex flex-wrap gap-x-1 gap-y-4 sm:gap-x-4">
          {
            shortcuts.map((s) => (
              <li>
                <a
                  href={s.href}
                  target={s.external ? "_blank" : undefined}
                  rel={s.external ? "noopener noreferrer" : undefined}
                  class="shortcut group flex w-16 flex-col items-center gap-1.5 text-center sm:w-20"
                >
                  <span class="grid size-14 place-items-center rounded-xl border-2 border-line bg-win shadow-[3px_3px_0_0_var(--shadow)] transition-transform duration-200 group-hover:-translate-y-0.5">
                    <PixelIcon name={s.icon} class="!size-8" />
                  </span>
                  <span class="shortcut-label rounded px-1.5 py-0.5 font-mono text-[11px] leading-tight font-medium">
                    {s.label}
                  </span>
                  {s.external && <span class="sr-only">(opens in a new tab)</span>}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <!-- About This Computer: spec sheet -->
    <div class="mx-auto w-full max-w-2xl xl:col-span-6 xl:max-w-none">
      <Window title="About Lhexus" file="system-info.app" icon="person" section="hero" reveal={false} closable={false} as="p">
        <div class="grid sm:grid-cols-[minmax(0,15rem)_1fr]">
          <figure class="relative border-b-[1.5px] border-line bg-[#f2f2f0] sm:border-r-[1.5px] sm:border-b-0">
            <img
              src={profile.photo}
              alt={`Portrait of ${profile.name} in a dark suit and tie, smiling`}
              width="900"
              height="1200"
              fetchpriority="high"
              decoding="async"
              class="aspect-[4/3] h-full w-full object-cover object-[50%_12%] sm:aspect-auto"
            />
            <figcaption
              class="absolute -bottom-3 left-3 w-44 -rotate-3 rounded-sm border-[1.5px] border-line bg-hi p-2.5 text-on-hi shadow-[3px_3px_0_0_var(--shadow)] sm:bottom-4 sm:left-3"
            >
              <span class="block font-mono text-[10px] font-bold tracking-[0.08em] uppercase">Currently</span>
              <span class="mt-0.5 block text-[13px] leading-snug font-semibold">
                Building Iskolar, a multi-tenant scholarship platform, as my capstone.
              </span>
            </figcaption>
          </figure>

          <div class="flex flex-col gap-5 p-5 pt-8 sm:p-6">
            <div>
              <p class="text-2xl leading-tight font-extrabold tracking-[-0.02em]">{profile.firstName} {profile.lastName}</p>
              <p class="mt-1 font-mono text-[13px] text-ink-2">{profile.role}</p>
            </div>

            <dl class="spec divide-y divide-line-soft border-y border-line-soft text-[14px]">
              {
                specs.map((row) => (
                  <div class="grid grid-cols-[6rem_1fr] gap-3 py-2">
                    <dt class="font-mono text-[12px] leading-5 font-medium">{row.k}</dt>
                    <dd class="leading-5 text-ink-2">{row.v}</dd>
                  </div>
                ))
              }
            </dl>

            <div class="mt-auto flex flex-wrap gap-2.5">
              <a href="#projects" class="btn btn-primary !px-3.5 !py-2 !text-sm">
                <span class="material-symbols-outlined !text-[17px]" aria-hidden="true">folder_open</span>
                Open my work
              </a>
              <a href={profile.resume} target="_blank" rel="noopener noreferrer" class="btn btn-ghost !px-3.5 !py-2 !text-sm">
                <span class="material-symbols-outlined !text-[17px]" aria-hidden="true">picture_as_pdf</span>
                Resume
                <span class="sr-only">(PDF, opens in a new tab)</span>
              </a>
            </div>
          </div>
        </div>
      </Window>
    </div>
  </div>
</section>

<style>
  .wallpaper-name {
    color: var(--ink);
    text-shadow: 4px 4px 0 var(--win);
  }
  .shortcut-label {
    color: var(--ink);
    background: color-mix(in srgb, var(--win) 80%, transparent);
  }
  .shortcut:hover .shortcut-label,
  .shortcut:focus-visible .shortcut-label {
    background: var(--accent);
    color: var(--on-accent);
  }
</style>
