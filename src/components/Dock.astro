---
import PixelIcon from "./PixelIcon.astro";
import { profile } from "../data/site";

const items = [
  { href: "#hero", label: "Home", icon: "home" },
  { href: "#about", label: "About", icon: "person" },
  { href: "#projects", label: "Projects", icon: "folder" },
  { href: "#skills", label: "Skills", icon: "chip" },
  { href: "#background", label: "Background", icon: "book" },
  { href: "#certificates", label: "Certificates", icon: "medal" },
  { href: "#contact", label: "Contact", icon: "mail" },
] as const;

const itemClass =
  "dock-item flex min-w-[3.5rem] shrink-0 flex-col items-center gap-1 rounded-xl px-1 pt-1 pb-0.5 sm:min-w-[4.75rem]";
const labelClass = "dock-label font-mono text-[9.5px] leading-tight font-medium text-ink sm:text-[11px]";
---

<div class="pixel-band" aria-hidden="true"></div>

<nav aria-label="Primary" class="fixed inset-x-0 bottom-2 z-50 flex justify-center px-2 sm:bottom-3">
  <div
    class="max-w-full overflow-hidden rounded-[1.25rem] border-2 border-line bg-win shadow-[4px_4px_0_0_var(--shadow)]"
  >
    <ul class="flex items-start gap-0.5 overflow-x-auto px-2 py-2 [scrollbar-width:none] sm:gap-1 sm:px-3">
      {
        items.map((item) => (
          <li class="flex">
            <a href={item.href} class={itemClass} data-dock={item.href.slice(1)}>
              <span class="dock-tile">
                <PixelIcon name={item.icon} />
              </span>
              <span class={labelClass}>{item.label}</span>
            </a>
          </li>
        ))
      }
      <li class="mx-1 my-2 w-0.5 shrink-0 self-stretch rounded-full bg-line-soft" aria-hidden="true"></li>
      <li class="flex">
        <a href={profile.resume} target="_blank" rel="noopener noreferrer" class={itemClass}>
          <span class="dock-tile">
            <PixelIcon name="doc" />
          </span>
          <span class={labelClass}>Resume</span>
          <span class="sr-only">(PDF, opens in a new tab)</span>
        </a>
      </li>
    </ul>
  </div>
</nav>

<script>
  // ---- active section: dock highlight + focused window ----
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>("[data-dock]").forEach((a) => links.set(a.dataset.dock!, a));

  const setActive = (id: string) => {
    links.forEach((a, key) => {
      if (key === id) {
        a.setAttribute("aria-current", "true");
        // Keep the active item visible when the dock scrolls on narrow screens.
        const strip = a.closest("ul");
        if (strip && strip.scrollWidth > strip.clientWidth) {
          strip.scrollTo({ left: a.offsetLeft - strip.clientWidth / 2 + a.offsetWidth / 2, behavior: "smooth" });
        }
      } else a.removeAttribute("aria-current");
    });
    document.querySelectorAll<HTMLElement>(".win[data-window]").forEach((w) => {
      w.dataset.active = String(w.dataset.window === id);
    });
  };

  const spy = new IntersectionObserver(
    (entries) => {
      for (const e of entries) if (e.isIntersecting) setActive(e.target.id);
    },
    { rootMargin: "-45% 0px -50% 0px" }
  );
  document.querySelectorAll<HTMLElement>("main section[id]").forEach((s) => spy.observe(s));
</script>
