---
import { profile } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="mx-auto max-w-6xl px-4 pt-6 pb-36 sm:px-6 sm:pb-40">
  <div class="flex flex-col items-center gap-4 border-t-[1.5px] border-dashed border-line-soft pt-10 text-center">
    <p class="font-mono text-[13px] font-medium tracking-[0.12em] text-ink">// END OF TRANSMISSION</p>
    <a
      href="#hero"
      class="inline-flex items-center gap-1.5 font-mono text-[13px] text-accent-ink underline decoration-dotted hover:decoration-solid"
    >
      <span class="material-symbols-outlined !text-[16px]" aria-hidden="true">arrow_upward</span>
      Back to top
    </a>
    <p class="text-[13px] text-ink-2">
      {`© ${year} ${profile.name}`} · Built with Astro &amp; Tailwind ·
      <a
        href="https://github.com/NotNookie/Portfolio"
        target="_blank"
        rel="noopener noreferrer"
        class="underline decoration-dotted hover:text-ink">source</a
      >
    </p>
  </div>
</footer>
