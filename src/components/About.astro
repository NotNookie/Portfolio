---
import Window from "./Window.astro";
import { profile, careerObjective } from "../data/site";

const info = [
  { k: "Name", v: profile.name },
  { k: "Course", v: profile.course },
  { k: "School", v: profile.school },
  { k: "Year", v: "4th Year (capstone)" },
  { k: "Graduating", v: "June–July 2027" },
  { k: "Based in", v: profile.location },
  { k: "Looking for", v: "OJT / internship (full-stack or web dev)" },
];
---

<section id="about" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
  <Window title="Career Objective" file="objective.txt" icon="doc" section="about" status="UTF-8 · read-only">
    <div class="grid gap-8 p-5 sm:p-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <div class="space-y-4 text-lg leading-relaxed sm:text-xl">
          {careerObjective.map((p, i) => <p class={i > 0 ? "text-ink-2" : ""}>{p}</p>)}
        </div>
      </div>

      <aside class="lg:col-span-5" aria-labelledby="info-title">
        <div class="rounded-lg border-[1.5px] border-line bg-win-2">
          <p id="info-title" class="flex items-center gap-2 border-b-[1.5px] border-line px-4 py-2.5 font-mono text-[13px] font-medium">
            <span class="material-symbols-outlined !text-[17px]" aria-hidden="true">info</span>
            Get info
          </p>
          <dl class="divide-y divide-line-soft px-4 text-[15px]">
            {
              info.map((row) => (
                <div class="grid grid-cols-[7.5rem_1fr] gap-3 py-2.5">
                  <dt class="font-mono text-[12px] leading-6 text-ink-2">{row.k}</dt>
                  <dd class="font-medium">{row.v}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </aside>
    </div>
  </Window>
</section>
