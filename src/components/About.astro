---
import Window from "./Window.astro";
import { careerObjective } from "../data/site";
---

<section id="about" class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-14">
  <Window
    title="Career Objective"
    file="objective.txt"
    icon="doc"
    section="about"
    status={`${careerObjective.length} paragraphs · UTF-8 · read-only`}
  >
    <ol class="editor">
      {
        careerObjective.map((p, i) => (
          <li class="grid grid-cols-[2.5rem_1fr] sm:grid-cols-[3.5rem_1fr]">
            <span class="gutter tabular" aria-hidden="true">
              {i + 1}
            </span>
            <p class:list={["max-w-[64ch] px-4 py-5 text-lg leading-relaxed sm:px-6 sm:text-xl", i > 0 && "text-ink-2"]}>
              {p}
            </p>
          </li>
        ))
      }
    </ol>
  </Window>
</section>

<style>
  .editor {
    background: linear-gradient(90deg, var(--win-2) 0 2.5rem, var(--line-soft) 2.5rem calc(2.5rem + 1px), transparent 0);
  }
  @media (min-width: 640px) {
    .editor {
      background: linear-gradient(90deg, var(--win-2) 0 3.5rem, var(--line-soft) 3.5rem calc(3.5rem + 1px), transparent 0);
    }
  }
  .gutter {
    padding-top: 1.45rem;
    padding-right: 0.75rem;
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--ink-2);
  }
  li + li {
    border-top: 1px dashed var(--line-soft);
  }
</style>
